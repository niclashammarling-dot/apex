# Environment / secrets — NEVER commit these
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Data / database (runtime artefacts)
data/apex.db
data/*.db-shm
data/*.db-wal
data/*.parquet
data/backtest_cache/
backend/data/*.db
logs/

# Regime EOD outputs — runtime state written by _save_result /
# _append_signal_trace, same reasoning as apex.db above: a git-tracked
# runtime output is destroyable by any `git checkout -- data/` (e.g. routine
# test-pollution cleanup), which is what pinned both files at their 2026-07-16
# committed content through 5+ weeks of live daily writes with the erasure
# never distinguishable from a genuinely failed write. See
# 2026-08-16-apex-trace-gap-erasure-not-failure (audit/CHECKS.md).
data/regime_signal_trace.jsonl
data/regime_result_cache.json

# WSL metadata
*:Zone.Identifier

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo
# Runtime state written by the live app — untracked 2026-09-11, same reasoning as regime_signal_trace.jsonl (2026-08-16):
# tracked live state reports as a perpetual modification and is one `git checkout -- data/` from erasure.
data/bayesian_multiplier_stats.json
data/calibration_done.txt
data/ipo_sentiment_cache.json
data/ipo_sentiment_history.json
data/weekly_report_sent.txt
# Host-published audit state — lives on the orphan branch audit-state, never on master
audit/state/
data/sweep_results.json
data/optimizer_results.json
data/objective_walkforward.json

# DB snapshots taken before destructive repairs (data/backups/*.csv row dumps are kept — they are the "before" measurement)
data/backups/**/*.db
data/backups/**/*.json
data/backups/**/*.log
data/backups/**/*.jsonl
data/.eod_replay.lock

# Runtime scheduler lock — holds the serving PID, created by main.py at startup
# (open(SCHEDULER_LOCK, "w")). Tracked until 2026-09-24, which put a PID diff in
# every commit made while a window was running.
data/scheduler.lock

# Runtime completion markers — written by the nightly collectors each run, same class
# as scheduler.lock: state, not source. Gated on before a dependent step runs.
data/pcr_collect_done.json
